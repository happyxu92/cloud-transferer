# ===== AList 连接 =====
ALIST_BASE=http://alist:5244
ALIST_USERNAME=admin
ALIST_PASSWORD=changeme

# ===== 路径（AList 中挂载的虚拟路径）=====
# 百度网盘 driver 挂载根路径
BAIDU_ROOT=/baidu
# 夸克网盘 driver 挂载根路径
QUARK_ROOT=/quark

# ===== 迁移策略 =====
# 同时进行的 copy 任务数（受 30Mbps 带宽 + 4GB 内存限制，建议 2）
MAX_CONCURRENCY=2
# 单文件最大允许尺寸 GB，超过则跳过（防撑爆 60G 系统盘）
MAX_FILE_GB=20
# 已存在策略: skip | overwrite | rename
EXISTS_POLICY=skip
# 失败重试次数
MAX_RETRY=3
# 单文件轮询超时（秒），超时视为失败
TASK_TIMEOUT_SEC=14400

# ===== 磁盘哨兵 =====
# AList 临时目录在容器内的挂载点
ALIST_TEMP_DIR=/alist-data/temp
# 占用百分比上限，超过后暂停下发新任务
DISK_PAUSE_PERCENT=80

# ===== 调度 =====
# 内置一个默认 job 的 cron 表达式（5 字段，留空则不启用定时）
DEFAULT_JOB_CRON=
DEFAULT_JOB_SRC=/baidu/迁移
DEFAULT_JOB_DST=/quark/归档

# ===== 数据/日志 =====
DATA_DIR=/data
LOG_LEVEL=INFO
